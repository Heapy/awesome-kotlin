{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "es2020"
    ],
    "types": [
      "node"
    ],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
